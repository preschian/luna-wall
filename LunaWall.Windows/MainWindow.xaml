<Window x:Class="LunaWall.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LunaWall"
        MinWidth="880" MinHeight="620"
        Width="1040" Height="800"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True"
        TextOptions.TextRenderingMode="ClearType"
        FontFamily="{StaticResource Sans}"
        Foreground="{StaticResource Ink}"
        Background="{StaticResource Bg}">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" />
    </WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="36" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Title bar -->
        <Border Background="{StaticResource Chrome}" BorderBrush="{StaticResource Hairline}" BorderThickness="0,0,0,1"
                MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                    <Image Source="pack://application:,,,/Assets/LunaWall.ico" Width="15" Height="15" />
                    <TextBlock Text="LunaWall" FontSize="12" FontWeight="Medium" Foreground="{StaticResource Ink72}"
                               Margin="9,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource CaptionButton}" Content="&#xE921;" Click="Minimize_Click" ToolTip="Minimize" />
                    <Button Style="{StaticResource CaptionButton}" Content="{Binding MaximizeGlyph}" Click="Maximize_Click" ToolTip="Maximize" />
                    <Button Style="{StaticResource CloseButton}" Content="&#xE8BB;" Click="Close_Click" ToolTip="Close to tray" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Shared header bar for Library / Settings -->
        <Border Grid.Row="1" Background="{StaticResource Panel}" BorderBrush="{StaticResource Hairline}"
                BorderThickness="0,0,0,1" Padding="24,12" Visibility="{Binding HeaderVisibility}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button Width="74" Height="42" Padding="0" BorderThickness="0" Background="Transparent"
                        Cursor="Hand" Click="GoHome_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border CornerRadius="5" ClipToBounds="True" Background="{StaticResource Tile}"
                                    BorderBrush="{StaticResource Edge}" BorderThickness="1">
                                <Image Source="{Binding HeroThumbnail}" Stretch="UniformToFill" />
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
                <StackPanel Grid.Column="1" Margin="16,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding HeroTitle}" FontSize="13" FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis" />
                    <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                        <Ellipse Width="6" Height="6" Fill="{Binding StatusBrush}" VerticalAlignment="Center" />
                        <TextBlock Style="{StaticResource Meta}" Text="{Binding StatusLine}" Margin="8,0,0,0"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button Style="{StaticResource Ghost}" Content="Today" Margin="0,0,8,0" Click="GoHome_Click" />
                    <Button Style="{StaticResource Ghost}" Content="Library" Margin="0,0,8,0" Click="GoLibrary_Click"
                            Visibility="{Binding LibraryNavVisibility}" />
                    <Button Style="{StaticResource Ghost}" Content="Settings" Click="GoSettings_Click"
                            Visibility="{Binding SettingsNavVisibility}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ================= HOME ================= -->
        <Grid Grid.Row="2" Visibility="{Binding HomeVisibility}">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" MinHeight="240" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid ClipToBounds="True" Background="#FF1A1D25">
                <Image Source="{Binding HeroImage}" Stretch="UniformToFill" />
                <Rectangle>
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0,1" EndPoint="0,0">
                            <GradientStop Offset="0" Color="#EB06080C" />
                            <GradientStop Offset="0.38" Color="#7306080C" />
                            <GradientStop Offset="0.68" Color="#0006080C" />
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>

                <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="24,20,0,0"
                        CornerRadius="13" Background="{StaticResource Glass}" BorderBrush="{StaticResource Edge}"
                        BorderThickness="1" Padding="11,5">
                    <TextBlock Style="{StaticResource Meta}" Text="{Binding StatusLabel}"
                               Foreground="{Binding StatusBrush}" FontWeight="Medium" />
                </Border>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,20,24,0">
                    <Button Style="{StaticResource GhostGlass}" Content="{Binding RefreshLabel}" Margin="0,0,8,0"
                            IsEnabled="{Binding CanRefresh}" Click="Refresh_Click" />
                    <Button Style="{StaticResource GhostGlass}" Content="Library" Margin="0,0,8,0" Click="GoLibrary_Click" />
                    <Button Style="{StaticResource GhostGlass}" Content="Settings" Click="GoSettings_Click" />
                </StackPanel>

                <Grid VerticalAlignment="Bottom" Margin="24,0,24,22">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Bottom" MaxWidth="660" HorizontalAlignment="Left">
                        <TextBlock Style="{StaticResource Meta}" Text="{Binding HeroDate}" Foreground="{StaticResource Amber}"
                                   FontWeight="Medium" Margin="0,0,0,10" />
                        <TextBlock Text="{Binding HeroTitle}" FontSize="30" FontWeight="SemiBold" TextWrapping="Wrap"
                                   LineHeight="35" />
                        <TextBlock Text="{Binding HeroCopyright}" FontSize="13" Foreground="{StaticResource Ink62}"
                                   TextWrapping="Wrap" Margin="0,8,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="24,0,0,0">
                        <Button Style="{StaticResource Ghost}" Content="{Binding PinLabel}" Margin="0,0,10,0"
                                Padding="18,10" FontSize="13" FontWeight="SemiBold"
                                Background="{Binding PinBackground}" BorderBrush="{Binding PinBorder}"
                                Foreground="{Binding PinForeground}"
                                IsEnabled="{Binding CanRefresh}" Click="TogglePin_Click" />
                        <Button Style="{StaticResource Ghost}" Content="View full" Padding="18,10" FontSize="13"
                                IsEnabled="{Binding HasCurrent}" Click="ViewFull_Click" />
                    </StackPanel>
                </Grid>
            </Grid>

            <Border Grid.Row="1" Background="{StaticResource Bg}" Padding="24,16,24,20">
                <StackPanel>
                    <Grid Margin="0,0,0,12">
                        <TextBlock Text="Last 8 days" FontSize="12" FontWeight="SemiBold" Foreground="#E6FFFFFF"
                                   VerticalAlignment="Bottom" />
                        <Button HorizontalAlignment="Right" BorderThickness="0" Background="Transparent" Cursor="Hand"
                                Click="GoLibrary_Click" VerticalAlignment="Bottom">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <TextBlock x:Name="t" Style="{StaticResource Meta}" Text="{Binding CatalogSummary}" />
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="t" Property="Foreground" Value="#CCFFFFFF" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>
                    <ItemsControl ItemsSource="{Binding RecentItems}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Rows="1" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Margin="0,0,10,0" Padding="0" BorderThickness="0" Background="Transparent"
                                        Cursor="Hand" Tag="{Binding}" Click="Tile_Click" HorizontalContentAlignment="Stretch">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <ContentPresenter />
                                        </ControlTemplate>
                                    </Button.Template>
                                    <StackPanel>
                                        <!-- Viewbox on a 160x90 child is the cheapest 16:9 box WPF has. -->
                                        <Border CornerRadius="6" ClipToBounds="True" Background="{StaticResource Tile}"
                                                BorderBrush="{Binding BorderBrush}" BorderThickness="{Binding BorderThickness}">
                                            <Viewbox Stretch="Uniform">
                                                <Grid Width="160" Height="90">
                                                    <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" />
                                                </Grid>
                                            </Viewbox>
                                        </Border>
                                        <TextBlock Style="{StaticResource Meta}" FontSize="10" Text="{Binding ShortDate}"
                                                   Foreground="{Binding DateBrush}" Margin="0,7,0,0" />
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ================= LIBRARY ================= -->
        <DockPanel Grid.Row="2" Visibility="{Binding LibraryVisibility}" Background="{StaticResource Bg}">
            <Border DockPanel.Dock="Top" Padding="24,14" BorderBrush="{StaticResource Hairline}" BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border CornerRadius="8" Background="{StaticResource Field}" BorderBrush="{StaticResource Hairline}"
                            BorderThickness="1" Padding="12,8" Margin="0,0,10,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource Meta}" Text="/" FontSize="12" Foreground="{StaticResource Ink35}"
                                       VerticalAlignment="Center" Margin="0,0,8,0" />
                            <Grid Grid.Column="1">
                                <TextBlock Text="Search titles, places, photographers…" FontSize="12"
                                           Foreground="{StaticResource Ink35}" VerticalAlignment="Center"
                                           Visibility="{Binding SearchPlaceholderVisibility}" IsHitTestVisible="False" />
                                <TextBox Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}" Background="Transparent"
                                         BorderThickness="0" Foreground="White" CaretBrush="White" FontSize="12"
                                         FontFamily="{StaticResource Sans}" VerticalContentAlignment="Center" Padding="0" />
                            </Grid>
                        </Grid>
                    </Border>
                    <Border Grid.Column="1" CornerRadius="8" ClipToBounds="True" BorderBrush="{StaticResource Edge}"
                            BorderThickness="1">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton Style="{StaticResource Chip}" GroupName="filter" Content="{Binding AllChipLabel}"
                                         IsChecked="{Binding ShowAll}" />
                            <RadioButton Style="{StaticResource Chip}" GroupName="filter" Content="{Binding PinnedChipLabel}"
                                         IsChecked="{Binding ShowPinnedOnly}" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
            <Grid>
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24,22,24,26">
                    <ItemsControl ItemsSource="{Binding Shelves}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,0,0,30">
                                    <Grid Margin="0,0,0,13">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Month}" FontSize="15" FontWeight="SemiBold" />
                                        <Rectangle Grid.Column="1" Height="1" Fill="{StaticResource Hairline}"
                                                   Margin="12,0" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="2" Style="{StaticResource Meta}" Text="{Binding Count}"
                                                   VerticalAlignment="Center" />
                                    </Grid>
                                    <ItemsControl ItemsSource="{Binding Items}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <UniformGrid Columns="5" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Margin="0,0,14,14" Padding="0" BorderThickness="0" Background="Transparent"
                                                        Cursor="Hand" Tag="{Binding}" Click="Tile_Click"
                                                        HorizontalContentAlignment="Stretch">
                                                    <Button.Template>
                                                        <ControlTemplate TargetType="Button">
                                                            <ContentPresenter />
                                                        </ControlTemplate>
                                                    </Button.Template>
                                                    <StackPanel>
                                                        <Border CornerRadius="7" ClipToBounds="True" Background="{StaticResource Tile}"
                                                                BorderBrush="{Binding BorderBrush}" BorderThickness="{Binding BorderThickness}">
                                                            <Viewbox Stretch="Uniform">
                                                                <Grid Width="160" Height="90">
                                                                    <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" />
                                                                    <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="6"
                                                                            CornerRadius="4" Background="#990A0C10" Padding="6,2">
                                                                        <TextBlock Style="{StaticResource Meta}" FontSize="10"
                                                                                   Text="{Binding DayNumber}" Foreground="#D9FFFFFF" />
                                                                    </Border>
                                                                    <TextBlock Style="{StaticResource Meta}" Text="{Binding PinMark}"
                                                                               Foreground="{StaticResource Amber}" FontSize="10"
                                                                               HorizontalAlignment="Right" VerticalAlignment="Top" Margin="7,6,7,0" />
                                                                </Grid>
                                                            </Viewbox>
                                                        </Border>
                                                        <TextBlock Text="{Binding Title}" FontSize="11" FontWeight="Medium"
                                                                   Foreground="{StaticResource Ink72}" TextWrapping="Wrap"
                                                                   MaxHeight="30" Margin="0,7,0,0" LineHeight="15" />
                                                    </StackPanel>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
                <TextBlock Text="{Binding EmptyNote}" FontSize="12" Foreground="{StaticResource Ink35}"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Visibility="{Binding EmptyNoteVisibility}" />
            </Grid>
        </DockPanel>

        <!-- ================= SETTINGS ================= -->
        <ScrollViewer Grid.Row="2" Visibility="{Binding SettingsVisibility}" Background="{StaticResource Bg}"
                      VerticalScrollBarVisibility="Auto" Padding="34,30">
            <StackPanel MaxWidth="720" HorizontalAlignment="Left">
                <TextBlock Text="Settings" FontSize="24" FontWeight="SemiBold" />
                <TextBlock Text="Auto-checks every 30 minutes and after your PC wakes." FontSize="13"
                           Foreground="{StaticResource Ink45}" Margin="0,4,0,26" />

                <Border CornerRadius="9,9,0,0" Background="{StaticResource Field}" BorderBrush="{StaticResource Hairline}"
                        BorderThickness="1" Padding="18,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Follow today automatically" FontSize="13" FontWeight="SemiBold" />
                            <TextBlock Text="Swap the desktop each morning unless a day is pinned." FontSize="12"
                                       Foreground="{StaticResource Ink45}" Margin="0,3,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                        <CheckBox Grid.Column="1" Style="{StaticResource Switch}" VerticalAlignment="Center" Margin="20,0,0,0"
                                  IsChecked="{Binding AutoRefreshEnabled}" />
                    </Grid>
                </Border>

                <Border Background="{StaticResource Field}" BorderBrush="{StaticResource Hairline}"
                        BorderThickness="1,0,1,1" Padding="18,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Launch at login" FontSize="13" FontWeight="SemiBold" />
                            <TextBlock Text="Start LunaWall in the tray when Windows starts." FontSize="12"
                                       Foreground="{StaticResource Ink45}" Margin="0,3,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                        <CheckBox Grid.Column="1" Style="{StaticResource Switch}" VerticalAlignment="Center" Margin="20,0,0,0"
                                  IsChecked="{Binding LaunchAtLoginEnabled}" />
                    </Grid>
                </Border>

                <Border Background="{StaticResource Field}" BorderBrush="{StaticResource Hairline}"
                        BorderThickness="1,0,1,1" Padding="18,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Keep the local catalog" FontSize="13" FontWeight="SemiBold" />
                            <TextBlock Text="Bing serves 8 days; LunaWall keeps every day it has seen." FontSize="12"
                                       Foreground="{StaticResource Ink45}" Margin="0,3,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                        <Border Grid.Column="1" CornerRadius="7" ClipToBounds="True" BorderBrush="{StaticResource Edge}"
                                BorderThickness="1" VerticalAlignment="Center" Margin="20,0,0,0">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton Style="{StaticResource Chip}" GroupName="retention" Content="90 days"
                                             Padding="12,6" IsChecked="{Binding RetainNinetyDays}" />
                                <RadioButton Style="{StaticResource Chip}" GroupName="retention" Content="Forever"
                                             Padding="12,6" IsChecked="{Binding RetainForever}" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <Border CornerRadius="0,0,9,9" Background="{StaticResource Field}" BorderBrush="{StaticResource Hairline}"
                        BorderThickness="1,0,1,1" Padding="18,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Cache folder" FontSize="13" FontWeight="SemiBold" />
                            <TextBlock Style="{StaticResource Meta}" FontSize="12" Text="{Binding StorageDirectory}"
                                       Margin="0,4,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                        <Button Grid.Column="1" Style="{StaticResource Ghost}" Content="Open" VerticalAlignment="Center"
                                Margin="20,0,0,0" Click="OpenStorage_Click" />
                    </Grid>
                </Border>

                <Border Margin="0,26,0,0" CornerRadius="9" BorderBrush="{StaticResource Edge}" BorderThickness="1"
                        Padding="18,14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding CacheSummary}" FontSize="12" Foreground="#80FFFFFF"
                                   TextWrapping="Wrap" LineHeight="18" VerticalAlignment="Center" />
                        <Button Grid.Column="1" Style="{StaticResource Ghost}" Content="Clean up" VerticalAlignment="Center"
                                Margin="20,0,0,0" Click="CleanUp_Click" />
                    </Grid>
                </Border>

                <TextBlock Text="{Binding LastError}" FontSize="12" Foreground="#FFE06C6C" TextWrapping="Wrap"
                           Margin="0,20,0,0" Visibility="{Binding ErrorVisibility}" />
            </StackPanel>
        </ScrollViewer>

        <!-- ================= DETAIL ================= -->
        <Grid Grid.Row="1" Grid.RowSpan="2" Visibility="{Binding DetailVisibility}">
            <Rectangle Fill="#B806080C" MouseLeftButtonDown="CloseDetail_Click" />
            <Border Margin="56,20,56,44" CornerRadius="12" ClipToBounds="True" Background="{StaticResource Panel}"
                    BorderBrush="{StaticResource Edge}" BorderThickness="1">
                <DockPanel>
                    <Grid DockPanel.Dock="Bottom" Background="{StaticResource Panel}" Margin="26,20,26,22">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Bottom">
                            <TextBlock Style="{StaticResource Meta}" Text="{Binding DetailMeta}" Foreground="{StaticResource Amber}"
                                       FontWeight="Medium" Margin="0,0,0,9" />
                            <TextBlock Text="{Binding DetailTitle}" FontSize="22" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding DetailCopyright}" FontSize="12" Foreground="#80FFFFFF"
                                       TextWrapping="Wrap" Margin="0,7,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="26,0,0,0">
                            <Button Style="{StaticResource Primary}" Content="Set as wallpaper" Margin="0,0,9,0"
                                    Padding="17,10" IsEnabled="{Binding CanRefresh}" Click="ApplyDetail_Click" />
                            <Button Style="{StaticResource Ghost}" Content="{Binding DetailPinLabel}" Padding="17,10"
                                    FontSize="13" IsEnabled="{Binding CanRefresh}" Click="PinDetail_Click" />
                            <Button Style="{StaticResource Ghost}" Content="Open folder" Padding="17,10" FontSize="13"
                                    Margin="9,0,0,0" Click="OpenDetailFolder_Click" />
                        </StackPanel>
                    </Grid>
                    <Grid Background="#FF1A1D25" ClipToBounds="True">
                        <Image Source="{Binding DetailImage}" Stretch="UniformToFill" />
                        <Button Style="{StaticResource Round}" Width="30" Height="30" Content="&#xE711;"
                                FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="11" HorizontalAlignment="Right"
                                VerticalAlignment="Top" Margin="14" Click="CloseDetail_Click" />
                        <Button Style="{StaticResource Round}" Content="&#xE76B;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="12"
                                HorizontalAlignment="Left" VerticalAlignment="Center" Margin="14,0,0,0" Click="PrevDetail_Click" />
                        <Button Style="{StaticResource Round}" Content="&#xE76C;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="12"
                                HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,14,0" Click="NextDetail_Click" />
                    </Grid>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
